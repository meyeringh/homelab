#!/usr/bin/env python3
"""Merge ProtonVPN WireGuard configs with the homelab peer.

Each output tunnel contains two peers: the Proton server (default route)
and the homelab WireGuard server (LAN access). The private key of one
Proton config is reused as identity for all tunnels — Proton accepts a
registered key on all of its servers. Import the results into the
WireGuard Android app (one tunnel per Proton server, switch with one tap).

Usage:
  scripts/wireguard-phone-config <dir-with-proton-confs> [--qr]
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path


def parse_conf(path):
    sections = {}
    current = None
    for line in Path(path).read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("["):
            current = sections.setdefault(line.strip("[]"), {})
        elif current is not None and "=" in line:
            key, value = (part.strip() for part in line.split("=", 1))
            current[key] = value
    return sections


def tunnel_name(path):
    # WireGuard tunnel names: [a-zA-Z0-9_=+.-], max 15 chars
    return re.sub(r"[^a-zA-Z0-9_=+.-]", "-", Path(path).stem)[:15]


def home_pubkey_from_cluster():
    return subprocess.check_output(
        ["kubectl", "--kubeconfig", "metal/kubeconfig.yaml", "-n", "wireguard",
         "exec", "deploy/wireguard", "--", "wg", "show", "wg0", "public-key"],
        text=True).strip()


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("proton_dir", help="directory with ProtonVPN .conf downloads")
    ap.add_argument("--identity", help="Proton conf providing the shared private key (default: first)")
    ap.add_argument("--home-endpoint", default="wg.meyeringh.org:51820")
    ap.add_argument("--home-pubkey", help="homelab server public key (default: fetch via kubectl)")
    ap.add_argument("--lan-cidr", default="192.168.1.0/24")
    ap.add_argument("--out", default="wg-phone-configs")
    ap.add_argument("--qr", action="store_true", help="print QR codes for the WireGuard app")
    args = ap.parse_args()

    confs = sorted(Path(args.proton_dir).glob("*.conf"))
    if not confs:
        sys.exit(f"no .conf files in {args.proton_dir}")

    identity = parse_conf(args.identity or confs[0])["Interface"]
    home_pubkey = args.home_pubkey or home_pubkey_from_cluster()

    outdir = Path(args.out)
    outdir.mkdir(parents=True, exist_ok=True)
    for conf in confs:
        peer = parse_conf(conf)["Peer"]
        text = f"""[Interface]
PrivateKey = {identity["PrivateKey"]}
Address = {identity["Address"]}
DNS = {identity.get("DNS", "10.2.0.1")}

[Peer]
# ProtonVPN {conf.stem}
PublicKey = {peer["PublicKey"]}
AllowedIPs = {peer.get("AllowedIPs", "0.0.0.0/0")}
Endpoint = {peer["Endpoint"]}

[Peer]
# homelab
PublicKey = {home_pubkey}
AllowedIPs = {args.lan_cidr}
Endpoint = {args.home_endpoint}
PersistentKeepalive = 25
"""
        out = outdir / f"{tunnel_name(conf)}.conf"
        out.write_text(text)
        out.chmod(0o600)
        print(f"wrote {out}")
        if args.qr:
            print(f"\n=== {out.stem} ===")
            subprocess.run(["qrencode", "-t", "ansiutf8"], input=text.encode(), check=True)

    phone_pubkey = subprocess.check_output(
        ["wg", "pubkey"], input=identity["PrivateKey"] + "\n", text=True).strip()
    print(f"\nphone publicKey  (apps/wireguard/values.yaml peers): {phone_pubkey}")
    print(f"phone allowedIPs (apps/wireguard/values.yaml peers): {identity['Address']}")


if __name__ == "__main__":
    main()
