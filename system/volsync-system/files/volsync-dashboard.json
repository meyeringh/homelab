{
  "uid": "volsync-backups",
  "title": "VolSync Backups",
  "tags": ["volsync", "backups"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "timezone": "browser",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Volumes out of sync",
      "datasource": "Prometheus",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(volsync_volume_out_of_sync)"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Replication status per volume",
      "datasource": "Prometheus",
      "gridPos": {"h": 7, "w": 18, "x": 6, "y": 0},
      "targets": [
        {"refId": "A", "expr": "volsync_volume_out_of_sync", "instant": true, "format": "table"}
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {"Value": "out of sync"}
          }
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Missed sync intervals (24h)",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (obj_namespace, obj_name) (increase(volsync_missed_intervals_total[24h]))",
          "legendFormat": "{{obj_namespace}}/{{obj_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average sync duration",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (obj_namespace, obj_name) (rate(volsync_sync_duration_seconds_sum[6h])) / sum by (obj_namespace, obj_name) (rate(volsync_sync_duration_seconds_count[6h]))",
          "legendFormat": "{{obj_namespace}}/{{obj_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Syncs completed per hour",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (obj_namespace, obj_name) (increase(volsync_sync_duration_seconds_count[1h]))",
          "legendFormat": "{{obj_namespace}}/{{obj_name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
