{
  "uid": "logs-overview",
  "title": "Logs Overview",
  "tags": ["logs", "loki"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by namespace",
      "datasource": "Loki",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate({namespace=~\".+\"}[5m]))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "logs/s", "custom": {"fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error log rate by namespace",
      "datasource": "Loki",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate({namespace=~\".+\"} |~ \"(?i)(error|fatal|panic)\" [5m]))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "logs/s", "custom": {"fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent errors (all namespaces)",
      "datasource": "Loki",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 9},
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\".+\"} |~ \"(?i)(error|fatal|panic)\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Loki ingestion rate",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))",
          "legendFormat": "bytes received"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active streams",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(loki_ingester_memory_streams)",
          "legendFormat": "streams"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request latency p99 by route",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(loki_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ]
}
