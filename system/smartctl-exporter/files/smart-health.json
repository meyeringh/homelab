{
  "uid": "smart-health",
  "title": "SMART Disk Health",
  "tags": ["storage", "smart"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "timezone": "browser",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices failing SMART",
      "datasource": "Prometheus",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "count(smartctl_device_smart_status == 0) or on() vector(0)"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Devices",
      "datasource": "Prometheus",
      "gridPos": {"h": 7, "w": 18, "x": 6, "y": 0},
      "targets": [
        {"refId": "A", "expr": "smartctl_device", "instant": true, "format": "table"}
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "Value": true
            }
          }
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_temperature{temperature_type=\"current\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Power-on hours",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_power_on_seconds / 3600",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "h"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "NVMe wear",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_percentage_used",
          "legendFormat": "{{device}} % used"
        },
        {
          "refId": "B",
          "expr": "smartctl_device_available_spare",
          "legendFormat": "{{device}} available spare"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error counters",
      "datasource": "Prometheus",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_media_errors",
          "legendFormat": "{{device}} media errors"
        },
        {
          "refId": "B",
          "expr": "smartctl_device_critical_warning",
          "legendFormat": "{{device}} critical warning"
        },
        {
          "refId": "C",
          "expr": "smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\", attribute_value_type=\"raw\"}",
          "legendFormat": "{{device}} reallocated sectors"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
